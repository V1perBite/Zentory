{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?project_ref=nzkoxiddpdtiqqhtawtu&features=database,debugging,development",
      "enabled": true,
      "timeout": 60000
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "timeout": 60000,
      "headers": {
        "Authorization": "Bearer {file:~/.config/opencode/.secrets/github-token}"
      }
    }
  },
  "experimental": {
    "mcp_timeout": 60000
  }
}
